{
  "name": "lone-star-lax",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lone Star Lax - a retro arcade lacrosse game set in the THSLL North District.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "balance": "esbuild src/dev/balance.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-balance.mjs --log-level=error && node node_modules/.cache/lsl-balance.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "human": "esbuild src/dev/human.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-human.mjs --log-level=error && node node_modules/.cache/lsl-human.mjs",
    "ai-audit": "esbuild src/dev/ai-audit.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-ai.mjs --log-level=error && node node_modules/.cache/lsl-ai.mjs",
    "audit": "node scripts/audit.mjs",
    "test:input": "node scripts/input-stress.mjs",
    "ratings": "esbuild src/dev/ratings.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-ratings.mjs --log-level=error && node node_modules/.cache/lsl-ratings.mjs",
    "dynasty": "esbuild src/dev/dynasty.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-dynasty.mjs --log-level=error && node node_modules/.cache/lsl-dynasty.mjs",
    "test:dynasty": "node scripts/dynasty-flow.mjs",
    "challenge": "esbuild src/dev/challenge.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-challenge.mjs --log-level=error && node node_modules/.cache/lsl-challenge.mjs",
    "scouting": "esbuild src/dev/scouting.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-scouting.mjs --log-level=error && node node_modules/.cache/lsl-scouting.mjs",
    "test:challenge": "node scripts/challenge-flow.mjs",
    "ladder": "esbuild src/dev/ladder.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-ladder.mjs --log-level=error && node node_modules/.cache/lsl-ladder.mjs",
    "world": "esbuild src/dev/world-check.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-world.mjs --log-level=error && node node_modules/.cache/lsl-world.mjs",
    "levels": "esbuild src/dev/levels.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-levels.mjs --log-level=error && node node_modules/.cache/lsl-levels.mjs",
    "test:responsive": "node scripts/responsive-check.mjs",
    "scoring": "esbuild src/dev/scoring.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-scoring.mjs --log-level=error && node node_modules/.cache/lsl-scoring.mjs",
    "modes": "esbuild src/dev/modes.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-modes.mjs --log-level=error && node node_modules/.cache/lsl-modes.mjs",
    "checklist": "esbuild src/dev/checklist.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-checklist.mjs --log-level=error && node node_modules/.cache/lsl-checklist.mjs",
    "stages": "esbuild src/dev/stages.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-stages.mjs --log-level=error && node node_modules/.cache/lsl-stages.mjs",
    "seed-save": "esbuild src/dev/seed-save.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-seed.mjs --log-level=error && node node_modules/.cache/lsl-seed.mjs",
    "test:ladder": "node scripts/ladder-flow.mjs",
    "careers": "esbuild src/dev/careers.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-careers.mjs --log-level=error && node node_modules/.cache/lsl-careers.mjs",
    "stories": "esbuild src/dev/stories.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-stories.mjs --log-level=error && node node_modules/.cache/lsl-stories.mjs",
    "abuse": "esbuild src/dev/abuse.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/lsl-abuse.mjs --log-level=error && node node_modules/.cache/lsl-abuse.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
